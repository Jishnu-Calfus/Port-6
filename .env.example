# OpenAI — used for embeddings, generation, and the intent-check classifier
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Chroma — persisted vector store (production)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# Where uploaded PDFs and the parent-chunk docstore live on disk
DOCUMENTS_DIR=./data/documents
PARENT_STORE_DIR=./data/parent_store

# Chunking (parent-child, recursive splitter)
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60

# Hybrid retrieval (BM25 + dense, fused via RRF) and reranking
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
RERANKER_MODEL=BAAI/bge-reranker-base

# OCR fallback for scanned pages with no extractable text layer
OCR_LANGUAGE=eng

# FastAPI base URL — Streamlit is a separate process, reaches the API over HTTP
API_BASE_URL=http://localhost:8000

# Redis — shared embedding cache, exact-match LLM cache, ingestion lock
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_TTL_SECONDS=86400

# LangSmith tracing (optional but recommended — near-zero setup cost)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=port6-rag
